# 自动识别文本文件，仓库中统一存储为 LF
* text=auto eol=lf

# Python 文件强制 LF
*.py text eol=lf

# Markdown / JSON / 配置文件强制 LF
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Shell 脚本必须 LF（避免 shebang 兼容问题）
*.sh text eol=lf

# Windows 批处理文件使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf